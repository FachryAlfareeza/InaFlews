# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored; .env.example is safe to commit as documentation.

# CARTO basemap API key (from the CARTO dashboard). Used by the map basemap
# tiles in components/dashboard/MapView.tsx. The NEXT_PUBLIC_ prefix exposes it
# to the browser, which is required because the tiles load client-side.
NEXT_PUBLIC_CARTO_API_KEY=
